{
  "expo": {
    "name": "Around Loei",
    "slug": "myproject",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myproject",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0e0dbe47-a6e4-45c5-a6e2-cf7750b17daf"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aroundloei.myproject"
    },
    "android": {
      "package": "com.aroundloei.myproject",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.panuwatkidtooksteam.myproject"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "แอปต้องการเข้าถึงรูปภาพเพื่อแนบสลิปการโอนเงิน"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleWebClientId": "257842962448-bglvn841dleo5v174su70fsj1mkdcn64.apps.googleusercontent.com",
      "googleAndroidClientId": "257842962448-69fen9uvetr1r0f20schbj0hv0unhqjf.apps.googleusercontent.com",
      "googleIosClientId": "",
      "router": {},
      "eas": {
        "projectId": "0e0dbe47-a6e4-45c5-a6e2-cf7750b17daf"
      }
    },
    "owner": "panuwatkidtooks-team"
  }
}
